# LGSPusula: boş şablon; gerçek değerler bu arşivde bulunmaz.
# Uygulama DB ve BUCKET adlı Cloudflare Worker nesne bağlamalarını kullanır.
# Aşağıdaki değişkenler yalnızca export/configure-cloudflare.mjs / Wrangler içindir.
# Bunlar Vercel'de D1/R2 bağlantısını kendiliğinden sağlamaz.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_D1_DATABASE_NAME=lgspusula-demo
CLOUDFLARE_R2_BUCKET_NAME=lgspusula-demo-photos
CLOUDFLARE_WORKER_NAME=lgspusula-demo

# Yerel geliştirme araçları için mevcut varsayılanlar
CLOUDFLARE_CF_FETCH_ENABLED=false
WRANGLER_SEND_METRICS=false
